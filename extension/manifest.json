{
  "manifest_version": 3,
  "name": "Mnemo",
  "version": "0.1.0",
  "description": "Shared LLM memory backed by a local Mnemo server.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Mnemo"
  }
}
